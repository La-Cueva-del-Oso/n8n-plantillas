{
  "name": "Calificacion de leads (plantilla de ejemplo)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "calificacion-de-leads",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Recibir formulario",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "f-nombre",
              "name": "nombre",
              "value": "={{ ($json.body?.nombre ?? $json.nombre ?? \"\").toString().trim() }}",
              "type": "string"
            },
            {
              "id": "f-correo",
              "name": "correo",
              "value": "={{ ($json.body?.correo ?? $json.correo ?? \"\").toString().trim().toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "f-telefono",
              "name": "telefono",
              "value": "={{ ($json.body?.telefono ?? $json.telefono ?? \"\").toString().trim() }}",
              "type": "string"
            },
            {
              "id": "f-mensaje",
              "name": "mensaje",
              "value": "={{ ($json.body?.mensaje ?? $json.mensaje ?? \"\").toString().trim() }}",
              "type": "string"
            },
            {
              "id": "f-presupuesto",
              "name": "presupuesto",
              "value": "={{ Number($json.body?.presupuesto ?? $json.presupuesto ?? 0) || 0 }}",
              "type": "number"
            },
            {
              "id": "f-urgencia",
              "name": "urgencia",
              "value": "={{ ($json.body?.urgencia ?? $json.urgencia ?? \"baja\").toString().trim().toLowerCase() }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Normalizar campos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-nombre",
              "leftValue": "={{ $json.nombre }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "c-correo",
              "leftValue": "={{ $json.correo }}",
              "rightValue": "@",
              "operator": { "type": "string", "operation": "contains" }
            },
            {
              "id": "c-telefono",
              "leftValue": "={{ $json.telefono }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Campos validos",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [480, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Reglas simples de ejemplo: ajusta los umbrales a tu negocio.\nreturn $input.all().map((item) => {\n  const d = item.json;\n  let puntos = 0;\n  if (d.presupuesto >= 1000000) puntos += 2;\n  else if (d.presupuesto >= 300000) puntos += 1;\n  if (d.urgencia === 'alta') puntos += 2;\n  else if (d.urgencia === 'media') puntos += 1;\n  if (d.mensaje.length >= 40) puntos += 1;\n  const calificacion = puntos >= 4 ? 'alto' : puntos >= 2 ? 'medio' : 'bajo';\n  return { json: { ...d, puntos, calificacion } };\n});"
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Calificar lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://crm.example.com/api/contactos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ nombre: $json.nombre, correo: $json.correo, telefono: $json.telefono, mensaje: $json.mensaje, presupuesto: $json.presupuesto, urgencia: $json.urgencia, calificacion: $json.calificacion }) }}",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Enviar al CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [960, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, mensaje: \"Recibimos tus datos. Te contactaremos pronto.\" }) }}",
        "options": { "responseCode": 200 }
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Responder recibido",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1200, -100]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, mensaje: \"Revisa que el nombre, el correo y el telefono esten completos.\" }) }}",
        "options": { "responseCode": 422 }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Responder datos incompletos",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [720, 120]
    }
  ],
  "connections": {
